# ==========================================
# Application Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit real secrets or production keys to source control.

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_APP_URL=http://localhost:8080

# AI Engine API Keys (Used in Supabase Edge Functions)
# Set via Supabase CLI or Dashboard: supabase secrets set GROQ_API_KEY=your_key
# GROQ_API_KEY=your-groq-api-key
